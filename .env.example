# Supabase — copier la "Connection string" (mode "Transaction" port 6543 pour prod, "Direct" port 5432 pour migrations)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars

ANTHROPIC_API_KEY=
MAPBOX_PUBLIC_TOKEN=

# Supabase Storage remplace AWS S3 (optionnel — configurer post-MVP)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=eu-west-3

PORT=3000
NODE_ENV=production
